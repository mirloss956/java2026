<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="760.0" prefHeight="600.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fileorganizer.controller.BatchRenameController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <children>

        <!-- ── 標題列 ──────────────────────────────────────────────── -->
        <Label text="批次重新命名"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <!-- ── 規則選擇頁籤 ─────────────────────────────────────────── -->
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="NEVER">

            <!-- ═══ 正規表達式 ═══ -->
            <Tab text="正規表達式取代">
                <GridPane hgap="10" vgap="8">
                    <padding><Insets top="12" right="4" bottom="12" left="4"/></padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" maxWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="搜尋（Regex）：" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-alignment: CENTER_RIGHT;"/>
                    <TextField fx:id="regexFindField" promptText="例：\\d{4}" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="取代為：" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-alignment: CENTER_RIGHT;"/>
                    <TextField fx:id="regexReplaceField" promptText="例：[年份] 或留白則刪除" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <CheckBox fx:id="regexIgnoreCase" text="不分大小寫"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
            </Tab>

            <!-- ═══ 插入文字 ═══ -->
            <Tab text="插入文字">
                <GridPane hgap="10" vgap="8">
                    <padding><Insets top="12" right="4" bottom="12" left="4"/></padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" maxWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="80" maxWidth="80"/>
                    </columnConstraints>

                    <Label text="插入文字：" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-alignment: CENTER_RIGHT;"/>
                    <TextField fx:id="insertTextField" promptText="要插入的字串" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="插入位置：" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-alignment: CENTER_RIGHT;"/>
                    <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <RadioButton fx:id="insertAtStart"  text="開頭"      toggleGroup="$insertPosGroup"/>
                        <RadioButton fx:id="insertBeforeExt" text="副檔名前"  toggleGroup="$insertPosGroup" selected="true"/>
                        <RadioButton fx:id="insertAtPos"    text="第"         toggleGroup="$insertPosGroup"/>
                        <Spinner fx:id="insertPosSpinner" min="0" max="200" initialValue="0"
                                 prefWidth="70" editable="true"/>
                        <Label text="字元後"/>
                    </HBox>
                </GridPane>
            </Tab>

            <!-- ═══ 大小寫轉換 ═══ -->
            <Tab text="大小寫">
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <padding><Insets top="12" right="4" bottom="12" left="4"/></padding>
                    <Label text="轉換方式："/>
                    <RadioButton fx:id="caseLower" text="全小寫" toggleGroup="$caseGroup"/>
                    <RadioButton fx:id="caseUpper" text="全大寫" toggleGroup="$caseGroup"/>
                    <RadioButton fx:id="caseTitle" text="首字大寫" toggleGroup="$caseGroup" selected="true"/>
                    <Label text="（副檔名不受影響）" style="-fx-text-fill: #888;"/>
                </HBox>
            </Tab>

            <!-- ═══ 加序號 ═══ -->
            <Tab text="加序號">
                <GridPane hgap="10" vgap="8">
                    <padding><Insets top="12" right="4" bottom="12" left="4"/></padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" maxWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="前綴：" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-alignment: CENTER_RIGHT;"/>
                    <TextField fx:id="serializePrefixField" promptText="例：photo_" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="後綴：" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-alignment: CENTER_RIGHT;"/>
                    <TextField fx:id="serializeSuffixField" promptText="例：_backup（選填）" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="起始數字：" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-alignment: CENTER_RIGHT;"/>
                    <Spinner fx:id="serializeStartSpinner" min="0" max="99999" initialValue="1"
                             prefWidth="90" editable="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="位數補零：" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-alignment: CENTER_RIGHT;"/>
                    <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <Spinner fx:id="serializePaddingSpinner" min="1" max="10" initialValue="3"
                                 prefWidth="70" editable="true"/>
                        <Label text="位（001, 0001 …）" style="-fx-text-fill: #666;"/>
                    </HBox>
                </GridPane>
            </Tab>
        </TabPane>

        <!-- ── 預覽標題 ──────────────────────────────────────────────── -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="預覽結果" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblPreviewCount" style="-fx-text-fill: #666;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 重新預覽" onAction="#handlePreview" styleClass="button-secondary"/>
        </HBox>

        <!-- ── 預覽 TableView ─────────────────────────────────────────── -->
        <TableView fx:id="previewTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colOriginal" text="原始檔名" prefWidth="300"/>
                <TableColumn fx:id="colNew"      text="新檔名"   prefWidth="300"/>
                <TableColumn fx:id="colState"    text="狀態"     prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="按「重新預覽」按鈕計算改名結果"/>
            </placeholder>
        </TableView>

        <!-- ── 底部按鈕列 ─────────────────────────────────────────────── -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label fx:id="lblStatusMsg" style="-fx-text-fill: #666; -fx-font-style: italic;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnUndo"    text="↩ 復原上次"   onAction="#handleUndo"    styleClass="button-secondary" disable="true"/>
            <Button fx:id="btnExecute" text="▶ 執行改名"   onAction="#handleExecute" styleClass="button-primary"   disable="true"/>
            <Button text="關閉"                             onAction="#handleClose"   styleClass="button-secondary"/>
        </HBox>

    </children>
</VBox>
