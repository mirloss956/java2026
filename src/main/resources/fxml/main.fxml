<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="640.0" prefWidth="960.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fileorganizer.controller.MainController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>

        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="section-box">
            <children>
                <Label style="-fx-font-weight: bold;" text="操作：" />

                <CheckBox fx:id="chkDryRun" text="預覽模式（不實際搬移）" />

                <CheckBox fx:id="toggleWatch" text="即時監控資料夾" />

                <Separator orientation="VERTICAL" />

                <Label text="掃描深度：" />
                <Spinner fx:id="spinnerDepth"
                         min="1" max="10" initialValue="1"
                         prefWidth="70.0"
                         editable="true" />
                <Label text="層" />

                <Separator orientation="VERTICAL" />

                <Button fx:id="btnScan"
                        mnemonicParsing="false"
                        onAction="#handleScan"
                        styleClass="button-secondary"
                        text="🔍 掃描" />

                <Button mnemonicParsing="false"
                        onAction="#onOpenDiskDashboard"
                        text="磁碟分析" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnOrganize"
                        mnemonicParsing="false"
                        onAction="#handleOrganize"
                        styleClass="button-primary"
                        text="▶ 開始整理" />

                <Button fx:id="btnUndo"
                        mnemonicParsing="false"
                        onAction="#handleUndo"
                        styleClass="button-secondary"
                        text="↩ 復原上一次操作" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="section-box"
              style="-fx-background-color: #f8fafc; -fx-padding: 8px;
                     -fx-background-radius: 5px; -fx-border-color: #e2e8f0;
                     -fx-border-radius: 5px;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;"
                       text="🔍 全文深度檢索：" />
                <TextField fx:id="txtSearch"
                           HBox.hgrow="ALWAYS"
                           prefHeight="30.0"
                           promptText="輸入關鍵字以檢索 .txt / .md / .docx / .pdf 內文段落..." />
                <Button fx:id="btnSearch"
                        mnemonicParsing="false"
                        onAction="#handleSearch"
                        prefHeight="30.0"
                        prefWidth="100.0"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-cursor: hand;"
                        text="搜尋內容" />
            </children>
        </HBox>

        <VBox fx:id="dropPane"
              alignment="CENTER"
              onDragDropped="#handleDragDropped"
              onDragOver="#handleDragOver"
              prefHeight="120.0"
              styleClass="drop-shadow-pane"
              VBox.vgrow="NEVER">
            <children>
                <Label fx:id="lblDropHint"
                       style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"
                       text="📂 將要整理的資料夾拖曳至此處，或點擊選擇資料夾" />
                <HBox fx:id="scanningIndicator" alignment="CENTER" spacing="8.0"
                      managed="false" visible="false">
                    <children>
                        <ProgressIndicator prefWidth="24.0" prefHeight="24.0" />
                        <Label fx:id="lblScanningHint"
                               style="-fx-font-size: 14px; -fx-text-fill: #3498db;"
                               text="處理中，請稍候..." />
                    </children>
                </HBox>
            </children>
        </VBox>

        <SplitPane dividerPositions="0.35" VBox.vgrow="ALWAYS">
            <items>

                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="執行進度與日誌：" />
                        <TextArea fx:id="lblStatus"
                                  editable="false"
                                  styleClass="log-area"
                                  VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="檔案處理清單：" />
                        <TableView fx:id="fileTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colName"   prefWidth="160.0" text="檔案名稱" />
                                <TableColumn fx:id="colPath"   prefWidth="200.0" text="原始路徑" />
                                <TableColumn fx:id="colSize"   prefWidth="80.0"  text="大小" />
                                <TableColumn fx:id="colStatus" prefWidth="90.0"  text="狀態" />
                                <TableColumn fx:id="colDest"   prefWidth="160.0" text="目的地" />
                            </columns>
                            <placeholder>
                                <Label text="尚未掃描任何檔案" />
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>

            </items>
        </SplitPane>

    </children>
</VBox>