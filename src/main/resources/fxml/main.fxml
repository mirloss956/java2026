public class FileTypeClassifier {
    private static final Map<String, String> EXT_TO_CATEGORY = Map.ofEntries(
        entry("jpg", "圖片"), entry("jpeg", "圖片"), entry("png", "圖片"),
        entry("gif", "圖片"), entry("webp", "圖片"), entry("heic", "圖片"),
        entry("mp4", "影片"), entry("mov", "影片"), entry("avi", "影片"), entry("mkv", "影片"),
        entry("mp3", "音樂"), entry("wav", "音樂"), entry("flac", "音樂"),
        entry("pdf", "文件"), entry("docx", "文件"), entry("xlsx", "文件"), entry("pptx", "文件"),
        entry("java", "程式碼"), entry("py", "程式碼"), entry("js", "程式碼"), entry("ts", "程式碼"),
        entry("zip", "壓縮檔"), entry("rar", "壓縮檔"), entry("7z", "壓縮檔")
    );

    private static final Map<String, String> CATEGORY_COLORS = Map.of(
        "圖片",   "#378ADD",
        "影片",   "#D85A30",
        "音樂",   "#1D9E75",
        "文件",   "#7F77DD",
        "程式碼", "#BA7517",
        "壓縮檔", "#D4537E",
        "其他",   "#888780"
    );

    public static String classify(Path file) {
        String ext = getExtension(file).toLowerCase();
        return EXT_TO_CATEGORY.getOrDefault(ext, "其他");
    }

    public static String colorFor(String category) {
        return CATEGORY_COLORS.getOrDefault(category, "#888780");
    }
}
2. B 實作掃描邏輯
重點是用 ForkJoinPool 做平行掃描，大資料夾才不會 lag：

java
public class DiskScanner {

    private final ExecutorService executor =
        Executors.newWorkStealingPool(); // 自動用 CPU 核心數

    public CompletableFuture<ScanSnapshot> scanAsync(
            Path root, Consumer<Long> onProgress) {

        return CompletableFuture.supplyAsync(() -> {
            Map<String, List<FileEntry>> grouped = new ConcurrentHashMap<>();
            Map<String, Long> categoryBytes = new ConcurrentHashMap<>();
            AtomicLong totalBytes = new AtomicLong(0);
            AtomicLong scannedCount = new AtomicLong(0);

            try {
                // Files.walk 在大資料夾可能很慢，改用並行版本
                Files.walk(root)
                    .parallel()
                    .filter(Files::isRegularFile)
                    .forEach(file -> {
                        try {
                            long size = Files.size(file);
                            String category = FileTypeClassifier.classify(file);

                            totalBytes.addAndGet(size);
                            categoryBytes.merge(category, size, Long::sum);
                            grouped.computeIfAbsent(category,
                                k -> Collections.synchronizedList(new ArrayList<>()))
                                .add(new FileEntry(file, size, category));

                            long count = scannedCount.incrementAndGet();
                            if (count % 100 == 0) {
                                onProgress.accept(count); // 每 100 個回報進度給 UI
                            }
                        } catch (IOException ignored) {}
                    });
            } catch (IOException e) {
                throw new RuntimeException("掃描失敗", e);
            }

            // 組裝 FileTypeStats 列表
            List<FileTypeStats> byType = categoryBytes.entrySet().stream()
                .map(e -> new FileTypeStats(
                    e.getKey(),
                    FileTypeClassifier.colorFor(e.getKey()),
                    e.getValue(),
                    grouped.get(e.getKey()).size(),
                    topN(grouped.get(e.getKey()), 5)
                ))
                .sorted(Comparator.comparingLong(FileTypeStats::totalBytes).reversed())
                .toList();

            // 全域前 20 大檔案
            List<FileEntry> topLargest = grouped.values().stream()
                .flatMap(List::stream)
                .sorted(Comparator.comparingLong(FileEntry::size).reversed())
                .limit(20)
                .toList();

            return new ScanSnapshot(root, Instant.now(),
                totalBytes.get(), scannedCount.get(), byType,
                buildFolderTree(root), topLargest);
        }, executor);
    }
}
