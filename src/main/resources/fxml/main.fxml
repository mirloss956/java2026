// service/impl/RenameServiceImpl.java
package com.fileorganizer.service.impl;

import com.fileorganizer.model.RenamePreview;
import com.fileorganizer.rule.*;
import com.fileorganizer.service.RenameService;

import java.io.IOException;
import java.nio.file.*;
import java.util.*;
import java.util.function.Consumer;

public class RenameServiceImpl implements RenameService {

    @Override
    public List<RenamePreview> preview(List<Path> files, List<RenameRule> rules) {
        // SequenceRule 每次 preview 前重置計數器
        rules.stream()
             .filter(r -> r instanceof SequenceRule)
             .map(r -> (SequenceRule) r)
             .forEach(SequenceRule::reset);

        Set<String> seenInBatch = new LinkedHashSet<>();
        List<RenamePreview> results = new ArrayList<>();

        for (Path file : files) {
            String ext        = getExt(file);
            String nameNoExt  = stripExt(file);
            String newName    = applyAll(nameNoExt, file, rules);

            // 撞名自動加 _1, _2...
            String finalName  = dedup(newName, ext, seenInBatch);
            seenInBatch.add((finalName + ext).toLowerCase(Locale.ROOT));

            Path target = file.resolveSibling(finalName + ext);
            boolean fsConflict  = Files.exists(target) && !target.equals(file);
            boolean batchDupl   = !finalName.equals(newName); // 有被 dedup 改動過

            results.add(new RenamePreview(file, target, fsConflict, batchDupl));
        }
        return results;
    }

    @Override
    public void execute(List<RenamePreview> previews,
                        Consumer<RenamePreview> onEach) throws IOException {
        for (RenamePreview p : previews) {
            if (!p.conflict()) {
                Files.move(p.original(), p.renamed(),
                           StandardCopyOption.ATOMIC_MOVE);
                onEach.accept(p);
            }
        }
    }

    // ── 工具方法 ──────────────────────────────────────────────

    private String applyAll(String name, Path file, List<RenameRule> rules) {
        String cur = name;
        for (RenameRule r : rules) {
            String result = r.apply(cur, file);
            if (result != null) cur = result;
        }
        return cur;
    }

    private String dedup(String base, String ext, Set<String> seen) {
        String candidate = base;
        int i = 1;
        while (seen.contains((candidate + ext).toLowerCase(Locale.ROOT)))
            candidate = base + "_" + i++;
        return candidate;
    }

    private static String getExt(Path p) {
        String name = p.getFileName().toString();
        int dot = name.lastIndexOf('.');
        return dot >= 0 ? name.substring(dot) : "";
    }

    private static String stripExt(Path p) {
        String name = p.getFileName().toString();
        int dot = name.lastIndexOf('.');
        return dot >= 0 ? name.substring(0, dot) : name;
    }
}
