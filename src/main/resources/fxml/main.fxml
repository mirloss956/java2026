// rule/RegexRule.java
package com.fileorganizer.rule;

import java.nio.file.Path;
import java.util.regex.*;

public class RegexRule implements RenameRule {

    private final Pattern pattern;
    private final String replacement;

    public RegexRule(String regex, String replacement) {
        this.pattern = Pattern.compile(regex);
        this.replacement = replacement;
    }

    @Override
    public String apply(String name, Path filePath) {
        Matcher m = pattern.matcher(name);
        if (!m.find()) return null;
        return m.replaceAll(replacement);
    }

    @Override
    public String getDescription() {
        return "Regex: /" + pattern.pattern() + "/ → " + replacement;
    }

    // 給 UI 即時驗證用：正規表達式是否合法
    public static boolean isValidRegex(String regex) {
        try { Pattern.compile(regex); return true; }
        catch (PatternSyntaxException e) { return false; }
    }
}
