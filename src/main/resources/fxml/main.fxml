2. RenameRule 介面（C 定義，A、B 對接）
java
public interface RenameRule {
    // 輸入：原始檔名（不含副檔名）+ 檔案完整路徑
    // 輸出：新的檔名（不含副檔名），回傳 null 表示此規則跳過
    String apply(String originalName, Path filePath);
    String getDescription(); // 顯示在 UI 上的說明文字
}
兩個常用實作：

java
// ── RegexRule：用正規表達式取代 ──────────────────────────
public class RegexRule implements RenameRule {
    private final Pattern pattern;
    private final String replacement; // 支援 $1 $2 反向引用

    public RegexRule(String regex, String replacement) {
        this.pattern = Pattern.compile(regex);
        this.replacement = replacement;
    }

    @Override
    public String apply(String name, Path filePath) {
        Matcher m = pattern.matcher(name);
        if (!m.find()) return null; // 不匹配就跳過
        return m.replaceAll(replacement);
    }

    @Override
    public String getDescription() {
        return "Regex: " + pattern.pattern() + " → " + replacement;
    }
}

// 範例用法：
// 把 "IMG_20240315_123456" 改成 "2024-03-15_123456"
new RegexRule("IMG_(\\d{4})(\\d{2})(\\d{2})_(.*)", "$1-$2-$3_$4");
java
// ── DateRule：從 EXIF 或檔案時間取日期 ────────────────────
public class DateRule implements RenameRule {
    private final String prefix;        // 自訂前綴，e.g. "photo"
    private final String dateFormat;    // e.g. "yyyy-MM-dd"

    @Override
    public String apply(String name, Path filePath) {
        LocalDate date = ExifReader.getDate(filePath)
                .orElse(getFileModifiedDate(filePath)); // fallback
        return prefix + "_" + date.format(DateTimeFormatter.ofPattern(dateFormat));
    }

    private LocalDate getFileModifiedDate(Path p) {
        try {
            FileTime ft = Files.getLastModifiedTime(p);
            return ft.toInstant().atZone(ZoneId.systemDefault()).toLocalDate();
        } catch (IOException e) { return LocalDate.now(); }
    }
}
3. ExifReader（C 實作）
java
public class ExifReader {

    public static Optional<LocalDate> getDate(Path filePath) {
        try {
            Metadata metadata = ImageMetadataReader.readMetadata(filePath.toFile());

            // 優先順序：拍攝時間 > GPS時間 > 數位化時間
            ExifSubIFDDirectory dir = metadata.getFirstDirectoryOfType(ExifSubIFDDirectory.class);
            if (dir != null) {
                Date d = dir.getDate(ExifSubIFDDirectory.TAG_DATETIME_ORIGINAL);
                if (d != null) {
                    return Optional.of(d.toInstant()
                            .atZone(ZoneId.systemDefault()).toLocalDate());
                }
            }
        } catch (Exception ignored) {}
        return Optional.empty();
    }

    public static Optional<String> getCameraModel(Path filePath) {
        try {
            Metadata metadata = ImageMetadataReader.readMetadata(filePath.toFile());
            ExifIFD0Directory dir = metadata.getFirstDirectoryOfType(ExifIFD0Directory.class);
            if (dir != null) {
                return Optional.ofNullable(dir.getString(ExifIFD0Directory.TAG_MODEL));
            }
        } catch (Exception ignored) {}
        return Optional.empty();
    }
}
4. RenameEngine（核心邏輯）
這是最重要的部分，負責 preview 和 execute 兩階段：

java
public class RenameEngine {

    public record RenameResult(
        Path original,
        Path renamed,
        boolean hasConflict,   // 目標名稱已存在
        boolean isDuplicate    // 和本次批次中其他檔案衝突
    ) {}

    // ── 預覽（不動任何檔案）─────────────────────────
    public List<RenameResult> preview(List<Path> files, List<RenameRule> rules) {
        Set<String> seenNames = new HashSet<>();
        List<RenameResult> results = new ArrayList<>();

        for (Path file : files) {
            String ext = getExtension(file);
            String nameOnly = getNameWithoutExtension(file);

            String newName = applyRules(nameOnly, file, rules);
            if (newName == null) newName = nameOnly; // 無規則匹配就保留原名

            // 序號處理：若重複則加 _1, _2...
            String finalName = resolveConflict(newName, ext, seenNames);
            seenNames.add(finalName.toLowerCase());

            Path target = file.resolveSibling(finalName + ext);
            boolean fsConflict = Files.exists(target) && !target.equals(file);

            results.add(new RenameResult(file, target, fsConflict,
                    !finalName.equals(newName + ext)));
        }
        return results;
    }

    // ── 執行（真正改名）─────────────────────────────
    public void execute(List<RenameResult> previewResults,
                        Consumer<RenameResult> onEach) throws IOException {
        for (RenameResult r : previewResults) {
            if (!r.hasConflict()) {
                Files.move(r.original(), r.renamed(), StandardCopyOption.ATOMIC_MOVE);
                onEach.accept(r); // 回報進度給 UI
            }
        }
    }

    private String applyRules(String name, Path file, List<RenameRule> rules) {
        String current = name;
        for (RenameRule rule : rules) {
            String result = rule.apply(current, file);
            if (result != null) current = result;
        }
        return current;
    }

    private String resolveConflict(String name, String ext, Set<String> seen) {
        String candidate = name;
        int counter = 1;
        while (seen.contains((candidate + ext).toLowerCase())) {
            candidate = name + "_" + counter++;
        }
        return candidate;
    }
}
