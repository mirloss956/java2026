// MainController.java — 新增的部分

@FXML private TextField regexField;
@FXML private TextField replacementField;
@FXML private TextField prefixField;
@FXML private ComboBox<String> ruleModeCombo;  // "Regex" / "日期" / "序號"
@FXML private TableView<RenamePreview> previewTable;
@FXML private TableColumn<RenamePreview, String> oldNameCol;
@FXML private TableColumn<RenamePreview, String> newNameCol;
@FXML private TableColumn<RenamePreview, String> statusCol;
@FXML private Button executeRenameBtn;
@FXML private Label conflictCountLabel;

private List<Path> selectedFiles = new ArrayList<>();
private List<RenamePreview> currentPreviews = new ArrayList<>();

@FXML
public void initialize() {
    setupTableColumns();

    // 任何輸入改變 → 即時重算 preview
    ChangeListener<Object> livePreview = (obs, o, n) -> refreshPreview();
    regexField.textProperty().addListener(livePreview);
    replacementField.textProperty().addListener(livePreview);
    prefixField.textProperty().addListener(livePreview);
    ruleModeCombo.valueProperty().addListener(livePreview);
}

private void refreshPreview() {
    if (selectedFiles.isEmpty()) return;

    List<RenameRule> rules = buildRules();
    if (rules.isEmpty()) return;

    // Regex 格式錯誤提示
    if (ruleModeCombo.getValue().equals("Regex")
            && !RegexRule.isValidRegex(regexField.getText())) {
        regexField.setStyle("-fx-border-color: #E24B4A; -fx-border-width: 1.5;");
        return;
    }
    regexField.setStyle("");

    currentPreviews = facade.previewRename(selectedFiles, rules);
    previewTable.setItems(FXCollections.observableArrayList(currentPreviews));

    long conflictCount = currentPreviews.stream()
        .filter(RenamePreview::hasIssue).count();
    conflictCountLabel.setText(conflictCount > 0
        ? conflictCount + " 個衝突" : "無衝突");
    conflictCountLabel.setStyle(conflictCount > 0
        ? "-fx-text-fill: #E24B4A;" : "-fx-text-fill: #1D9E75;");

    executeRenameBtn.setDisable(
        currentPreviews.stream().allMatch(RenamePreview::hasIssue));
}

private List<RenameRule> buildRules() {
    return switch (ruleModeCombo.getValue()) {
        case "Regex" -> List.of(new RegexRule(
            regexField.getText(), replacementField.getText()));
        case "日期"  -> List.of(new DateRule(
            prefixField.getText(), "yyyy-MM-dd"));
        case "序號"  -> List.of(new SequenceRule(
            prefixField.getText(), 1, 3));
        default -> List.of();
    };
}

private void setupTableColumns() {
    oldNameCol.setCellValueFactory(c ->
        new SimpleStringProperty(c.getValue().originalName()));
    newNameCol.setCellValueFactory(c ->
        new SimpleStringProperty(c.getValue().renamedName()));

    // 衝突行標紅、正常行正常
    statusCol.setCellValueFactory(c -> new SimpleStringProperty(
        c.getValue().conflict()   ? "名稱衝突" :
        c.getValue().duplicate()  ? "批次重複" : "正常"));

    previewTable.setRowFactory(tv -> new TableRow<>() {
        @Override
        protected void updateItem(RenamePreview item, boolean empty) {
            super.updateItem(item, empty);
            if (!empty && item != null && item.hasIssue())
                setStyle("-fx-background-color: #FFF0F0;");
            else
                setStyle("");
        }
    });
}

@FXML
private void onExecuteRename() {
    try {
        facade.executeRename(currentPreviews, done ->
            Platform.runLater(() ->
                statusLabel.setText("已完成：" + done.renamedName())));
        refreshPreview(); // 執行完重新 preview 確認結果
    } catch (IOException e) {
        showError("重新命名失敗：" + e.getMessage());
    }
