// rule/SequenceRule.java
package com.fileorganizer.rule;

import java.nio.file.Path;
import java.util.concurrent.atomic.AtomicInteger;

public class SequenceRule implements RenameRule {

    private final String prefix;
    private final int startFrom;
    private final int digits;     // 補零位數，e.g. 3 → 001, 002
    private final AtomicInteger counter;

    public SequenceRule(String prefix, int startFrom, int digits) {
        this.prefix = prefix;
        this.startFrom = startFrom;
        this.digits = digits;
        this.counter = new AtomicInteger(startFrom);
    }

    @Override
    public String apply(String name, Path filePath) {
        String num = String.format("%0" + digits + "d", counter.getAndIncrement());
        return prefix.isBlank() ? num : prefix + "_" + num;
    }

    @Override
    public String getDescription() {
        return "序號: " + prefix + "_" + "0".repeat(digits) + " (從 " + startFrom + " 起)";
    }

    // 重置計數器（每次新的 preview 前要呼叫）
    public void reset() { counter.set(startFrom); }
}
