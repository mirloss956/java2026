// rule/DateRule.java
package com.fileorganizer.rule;

import com.drew.imaging.ImageMetadataReader;
import com.drew.metadata.exif.*;
import java.io.IOException;
import java.nio.file.*;
import java.nio.file.attribute.FileTime;
import java.time.*;
import java.time.format.DateTimeFormatter;
import java.util.Date;

public class DateRule implements RenameRule {

    private final String prefix;
    private final String datePattern; // e.g. "yyyy-MM-dd"

    public DateRule(String prefix, String datePattern) {
        this.prefix = prefix;
        this.datePattern = datePattern;
    }

    @Override
    public String apply(String name, Path filePath) {
        LocalDate date = readExifDate(filePath)
                .orElseGet(() -> readFileDate(filePath));
        String formatted = date.format(DateTimeFormatter.ofPattern(datePattern));
        return prefix.isBlank() ? formatted : prefix + "_" + formatted;
    }

    @Override
    public String getDescription() {
        return "日期命名: " + (prefix.isBlank() ? "" : prefix + "_") + datePattern;
    }

    private java.util.Optional<LocalDate> readExifDate(Path file) {
        try {
            var meta = ImageMetadataReader.readMetadata(file.toFile());
            var dir  = meta.getFirstDirectoryOfType(ExifSubIFDDirectory.class);
            if (dir != null) {
                Date d = dir.getDate(ExifSubIFDDirectory.TAG_DATETIME_ORIGINAL);
                if (d != null)
                    return java.util.Optional.of(
                        d.toInstant().atZone(ZoneId.systemDefault()).toLocalDate());
            }
        } catch (Exception ignored) {}
        return java.util.Optional.empty();
    }

    private LocalDate readFileDate(Path file) {
        try {
            FileTime ft = Files.getLastModifiedTime(file);
            return ft.toInstant().atZone(ZoneId.systemDefault()).toLocalDate();
        } catch (IOException e) {
            return LocalDate.now();
        }
    }
}
