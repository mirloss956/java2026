package com.fileorganizer.service;

import com.fileorganizer.model.RenamePreview;
import com.fileorganizer.rule.RenameRule;
import java.io.IOException;
import java.nio.file.Path;
import java.util.List;
import java.util.function.Consumer;

public interface RenameService {
    /** 預覽，不移動任何檔案 */
    List<RenamePreview> preview(List<Path> files, List<RenameRule> rules);

    /** 真正執行，跳過有衝突的項目 */
