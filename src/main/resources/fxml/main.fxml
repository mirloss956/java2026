public class DiskPieChartController {

    @FXML private PieChart pieChart;
    @FXML private Label totalSizeLabel;
    @FXML private VBox legendBox;

    public void update(ScanSnapshot snapshot) {
        // 必須在 JavaFX 執行緒更新 UI
        Platform.runLater(() -> {
            ObservableList<PieChart.Data> data = FXCollections.observableArrayList();

            for (FileTypeStats stats : snapshot.byType()) {
                PieChart.Data slice = new PieChart.Data(
                    stats.category() + "\n" + stats.formattedSize(),
                    stats.totalBytes()
                );
                data.add(slice);
            }

            pieChart.setData(data);
            pieChart.setLegendVisible(false); // 自己做圖例更好看
            pieChart.setLabelsVisible(false);

            // 用 CSS 設定每個扇形顏色（JavaFX 圓餅圖用 CSS 控制顏色）
            Platform.runLater(() -> {
                for (int i = 0; i < data.size(); i++) {
                    FileTypeStats stats = snapshot.byType().get(i);
                    data.get(i).getNode().setStyle(
                        "-fx-pie-color: " + stats.color() + ";"
                    );
                }
            });

            // 點擊扇形 → 在右側顯示該類別的最大檔案清單
            for (int i = 0; i < data.size(); i++) {
                final FileTypeStats stats = snapshot.byType().get(i);
                data.get(i).getNode().setOnMouseClicked(e ->
                    showCategoryDetail(stats));
            }

            totalSizeLabel.setText(humanReadableBytes(snapshot.totalBytes())
                + "（" + snapshot.fileCount() + " 個檔案）");

            buildLegend(snapshot.byType());
        });
    }

    private void buildLegend(List<FileTypeStats> types) {
        legendBox.getChildren().clear();
        for (FileTypeStats stats : types) {
            HBox row = new HBox(8);
            row.setAlignment(Pos.CENTER_LEFT);

            // 色塊
            Region dot = new Region();
            dot.setPrefSize(12, 12);
            dot.setStyle("-fx-background-color: " + stats.color()
                + "; -fx-background-radius: 3;");

            // 名稱 + 大小 + 百分比
            Label name = new Label(stats.category());
            name.setStyle("-fx-font-weight: bold;");
            Label detail = new Label(
                stats.formattedSize() + "  ("
                + String.format("%.1f", stats.percentage(totalBytes)) + "%)");
            detail.setStyle("-fx-text-fill: -fx-text-secondary;");

            row.getChildren().addAll(dot, name, detail);
            legendBox.getChildren().add(row);
        }
    }
}
進度條式 TreeMap（最容易讓人眼前一亮）
JavaFX 沒有內建 TreeMap chart，但用巢狀 StackPane + 比例計算可以做出一個：

java
public class FolderTreeMapView extends Pane {

    public void render(List<FolderStats> folders, long totalBytes) {
        getChildren().clear();
        double w = getWidth(), h = getHeight();
        squarify(folders, totalBytes, 0, 0, w, h);
    }

    // 簡化版 squarify 演算法
    private void squarify(List<FolderStats> items, long total,
                           double x, double y, double w, double h) {
        if (items.isEmpty() || total == 0) return;

        for (FolderStats folder : items) {
            double ratio = (double) folder.totalBytes() / total;
            double cellW = w * ratio;  // 簡化版：直接按比例橫向切

            Rectangle cell = new Rectangle(x, y, Math.max(cellW - 2, 2), Math.max(h - 2, 2));
            cell.setFill(Color.web(colorByDepth(folder)));
            cell.setArcWidth(4);
            cell.setArcHeight(4);

            Label label = new Label(folder.path().getFileName().toString()
                + "\n" + humanReadableBytes(folder.totalBytes()));
            label.setLayoutX(x + 4);
            label.setLayoutY(y + 4);
            label.setMaxWidth(cellW - 8);
            label.setStyle("-fx-font-size: 11; -fx-text-fill: white;");

            // 滑鼠懸停提示
            Tooltip.install(cell, new Tooltip(
                folder.path().toString() + "\n" +
                humanReadableBytes(folder.totalBytes())));

            getChildren().addAll(cell, label);
            x += cellW;
        }
    }
}
