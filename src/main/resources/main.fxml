<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="10.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fileorganizer.controller.MainController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="section-box">
            <children>
                <Label style="-fx-font-weight: bold;" text="分類規則設定：" />
                <CheckBox fx:id="chkExtension" selected="true" text="依副檔名分類" />
                <CheckBox fx:id="chkDuplicate" text="偵測重複檔案" />
                <Button fx:id="btnUndo" mnemonicParsing="false" onAction="#handleUndo" styleClass="button-secondary" text="↩ 復原上一次操作" />
            </children>
            <VBox.margin>
                <Insets />
            </VBox.margin>
        </HBox>

        <VBox fx:id="dropPane" alignment="CENTER" onDragDropped="#handleDragDropped" onDragOver="#handleDragOver" prefHeight="150.0" styleClass="drop-shadow-pane" VBox.vgrow="NEVER">
            <children>
                <Label fx:id="lblDropHint" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;" text="📂 將要整理的資料夾拖曳至此處，或點擊選擇資料夾" />
            </children>
        </VBox>

        <SplitPane dividerPositions="0.4" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <items>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="執行進度與日誌：" />
                        <TextArea fx:id="txtLog" editable="false" prefHeight="200.0" prefWidth="200.0" styleClass="log-area" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="檔案處理清單：" />
                        <TableView fx:id="tblFiles" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colName" prefWidth="150.0" text="檔案名稱" />
                                <TableColumn fx:id="colPath" prefWidth="200.0" text="原始路徑" />
                                <TableColumn fx:id="colSize" prefWidth="80.0" text="大小" />
                                <TableColumn fx:id="colStatus" prefWidth="100.0" text="狀態" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>